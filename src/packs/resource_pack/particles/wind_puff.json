{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hunting:wind_puff",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.wind.direction_x",
          "variable.wind.direction_y",
          "variable.wind.direction_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "3.0 + math.random(0, 1.5)"
      },
      "minecraft:particle_initial_speed": "variable.wind.speed * 20 + math.random(0, 0.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -0.05,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + variable.particle_age * 0.12",
          "0.12 + variable.particle_age * 0.12"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [
              56,
              0
            ],
            "size_UV": [
              8,
              8
            ],
            "step_UV": [
              -8,
              0
            ],
            "frames_per_second": 2,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.93,
          0.92,
          0.88,
          "1 - variable.particle_age / variable.particle_lifetime"
        ]
      }
    }
  }
}